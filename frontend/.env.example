# Copy to frontend/.env.local (dev) or frontend/.env.production (prod build).
# Never commit the filled-in file.

# Read in lib/api.ts. NEXT_PUBLIC_* vars are baked into the build at
# `bun run build` time, not read at runtime — set this BEFORE building,
# and rebuild if it changes.
NEXT_PUBLIC_API_URL=http://localhost:8000
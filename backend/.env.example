# Copy to backend/.env and fill in real values. Never commit the filled-in file.
# Every value here corresponds to a field in app/core/config.py:Settings.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=case_management

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be a real random value in production — there is no safe default.
JWT_SECRET_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Must exactly match the deployed frontend's origin (scheme + host, no
# trailing slash) — main.py's CORSMiddleware only allows this one origin.
FRONTEND_ORIGIN=http://localhost:3000